{
    "configurations": [
        {
            "request": "launch",
            "name": "Launch Chrome",
            "type": "chrome",
            "preLaunchTask": "default",
            "webRoot": "${workspaceRoot}",
            "breakOnLoad": true,
            "internalConsoleOptions": "openOnSessionStart",
            "url": "http://localhost:2000"
        },
        {
            "request": "launch",
            "name": "MacOS (HashLink SDL)",
            "type": "hl",
            "preLaunchTask": "mac debug",
            "program": "${workspaceFolder}/bin/app.hl",
            "cwd": "${workspaceFolder}/bin/"
        },
        {
            "request": "launch",
            "name": "Windows (HashLink DirectX)",
            "type": "hl",
            "preLaunchTask": "win debug",
            "program": "${workspaceFolder}/bin/app.hl",
            "cwd": "${workspaceFolder}/bin/"
        },
        {
            "request": "launch",
            "name": "Android launch debug build",
            "type": "android",
            "apkFile": "${workspaceRoot}/bin/android/app/build/outputs/apk/debug/app-debug.apk",
            "preLaunchTask": "android debug",
            "adbPort": 5037,
            "appSrcRoot": "${workspaceRoot}/bin/android/app/src/main",
            "trace": true
        },
        {
            "request": "launch",
            "name": "Android launch release build",
            "type": "android",
            "apkFile": "${workspaceRoot}/bin/android/app/build/outputs/apk/release/app-release.apk",
            "preLaunchTask": "android release",
            "adbPort": 5037,
            "appSrcRoot": "${workspaceRoot}/bin/android/app/src/main",
            "trace": true
        }
    ],
    "version": "0.2.0"
}